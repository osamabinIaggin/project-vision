# ----------------------------------------------------------------------------
# Geospatial binary artefacts — excluded by policy.
# These are deterministically reproducible from the acquisition scripts in
# scripts/ and routinely exceed the platform's per-blob size ceiling. The
# repository versions the methodology, not the raster payload.
# ----------------------------------------------------------------------------
*.tif
*.tiff
*.tif.aux.xml
*.tif.ovr
*.osm
*.osm.pbf
*.gpkg
*.gpkg-wal
*.gpkg-shm

# Derived intermediates and scratch outputs
/accra_flood/output/
# regenerated by scripts/11 (Open Buildings download + AOI filter)
/accra_flood/oldfadama/open_buildings/
# regenerated by scripts/05
/accra_flood/oldfadama/tiles/
# raw Overpass payload, regenerated by scripts/21
/accra_flood/drains/
# middle-Odaw corpus, regenerated by scripts/24-26. scenes.json is the scene
# catalogue and IS versioned: it is the acquisition methodology, not payload.
/accra_flood/middleodaw/imagery/
/accra_flood/middleodaw/osm/
/accra_flood/middleodaw/open_buildings/
/accra_flood/middleodaw/tiles/
/scratch/

# Local tooling / agent configuration (not project content)
.claude/
*.png
# Curated figures are retained deliberately (negation must be on its own line;
# gitignore does not support trailing inline comments on pattern lines).
!docs/figures/*.png
# Report figures, regenerated by scripts/29
!docs/paper/fig/*.png
# Dashboard build artefacts are regenerated by scripts/30
/docs/dashboard/data.js
/docs/dashboard/standalone.html
# GDAL raster sidecars are never versioned
*.msk
*.aux.xml

# Operating-system and editor detritus
.DS_Store
.ipynb_checkpoints/
__pycache__/
*.pyc
.venv/
venv/
